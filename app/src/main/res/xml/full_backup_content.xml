<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 ja vanemad ei erista pilvevarundust telefonilt telefonile
    ülekandest, seega saab siin valida ainult "kõik või mitte midagi".
    Valime mitte midagi: pilve me andmeid ei saada ja vanemate versioonide
    ülekandest loobumine on väike hind.

    Android 12+ kasutab selle asemel data_extraction_rules.xml faili, kus
    ülekanne on lubatud ja ainult pilv keelatud.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
